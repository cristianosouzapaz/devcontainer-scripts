{
    "customizations": {
        "vscode": {
            "extensions": [
                "Anthropic.claude-code",
                "bierner.markdown-mermaid",
                "GitHub.vscode-pull-request-github",
                "redhat.vscode-yaml",
                "yzhang.markdown-all-in-one"
            ]
        }
    },
    "build": {
        "args": {
            "PROJECT_NAME": "project-name"
        },
        "dockerfile": "Dockerfile"
    },
    "name": "project-name",
    "postCreateCommand": "/opt/devcontainer/devcontainer-setup.sh",
    "remoteEnv": {
        "CODING_AGENTS": "claude",
        "GIT_EMAIL": "",
        "GIT_USER": "",
        "PROJECT_NAME": "project-name",
        "REPO_SOURCE": ""
    },
    "remoteUser": "root",
    "runArgs": [
        "--name=project-name"
    ],
    "shutdownAction": "none",
    "workspaceFolder": "/workspace/project-name",
    "workspaceMount": "source=project-name-data,target=/workspace,type=volume"
}