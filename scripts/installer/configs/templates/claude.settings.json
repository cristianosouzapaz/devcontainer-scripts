{
    "enableAllProjectMcpServers": true,
    "permissions": {
        "defaultMode": "default",
        "allow": [
            "Artifact",
            "Bash(*)",
            "Edit(*)",
            "mcp__context7__*",
            "Read(*)",
            "Skill(*)",
            "WebFetch(*)",
            "WebSearch(*)",
            "Write(*)"
        ],
        "deny": [
            "Bash(gh pr close *)",
            "Bash(gh pr merge *)",
            "Bash(gh pr review *)",
            "Bash(git commit*)",
            "Bash(git push*)"
        ]
    }
}