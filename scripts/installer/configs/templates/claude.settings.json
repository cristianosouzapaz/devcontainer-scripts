{
    "enableAllProjectMcpServers": true,
    "permissions": {
        "allow": [
            "Bash(*)",
            "Edit(*)",
            "mcp__*",
            "Read(*)",
            "Skill(*)",
            "WebFetch(*)",
            "WebSearch(*)",
            "Write(*)"
        ],
        "deny": [
            "Bash(gh pr close *)",
            "Bash(gh pr create *)",
            "Bash(gh pr edit *)",
            "Bash(gh pr merge *)",
            "Bash(gh pr review *)",
            "Bash(git commit*)",
            "Bash(git push*)"
        ]
    }
}