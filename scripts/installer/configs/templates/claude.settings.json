{
    "enableAllProjectMcpServers": true,
    "permissions": {
        "allow": [
            "Bash(*)",
            "Edit(*)",
            "Read(*)",
            "WebFetch(*)",
            "Skill(impeccable)"
        ],
        "deny": [
            "Bash(git commit*)",
            "Bash(git push*)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge *)",
            "Bash(gh pr close *)",
            "Bash(gh pr edit *)",
            "Bash(gh pr review *)"
        ]
    },
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp@latest"]
        }
    }
}
