# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# This file lists files and folders Git should ignore
# to keep local artifacts out of the repository history.

# Package dependencies
/node_modules
/.pnp
.pnp.js
.pnpm-store

# Build & framework output
/build
/dist
/.next/
/out/
/.turbo/
/.cache/
next-env.d.ts

# Test output & coverage
/coverage

# Cache & temporary files
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.eslintcache

# Generated source
*.tsbuildinfo

# Environment & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Database & local state
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# Deployment config
.vercel

# Tooling & editor config
/*.superpowers/
.claude/settings.local.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
