#!/bin/bash
set -euo pipefail

# Direct CLI for persistent-data categories.

# ----- SHARED UTILITIES LOADING -----------------------------------------------

# why: readlink -f, so a symlink on PATH still finds the script tree
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
BOOTSTRAP_LIB_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/../setup/lib" && pwd)"
source "$BOOTSTRAP_LIB_DIR/loader.sh"

# ----- INTERNAL HELPERS -------------------------------------------------------

# cli_usage: logs the supported command syntax
cli_usage() {
	log_info 'Usage: devcontainer-data {list|status|path <id>|repair|reset <id> [--yes]|interactive}'
}

# cli_category_fields <category_id>: prints scope, relative path, label, identity, resettable and Herdr integration, joined by unit separators with empty fields kept
cli_category_fields() {
	inventory_fields all "$1" scope relativePath label identity resettable herdrIntegration
}

# cli_link_problem <category_id>: prints what is wrong with the category's managed link, naming the path and its expected target
# Returns: 1 when the link is in place or the category has no managed link.
# Notes: a broken link makes the tool that owns the path lose its configuration, which
#   its status command reports as "not authenticated", so callers check this first.
cli_link_problem() {
	local category_id="$1" state destination source_path

	state=$(persistent_data_link_state "$category_id")
	[[ "$state" == 'ok' || "$state" == 'none' ]] && return 1

	destination=$(persistent_data_link_path "$category_id")
	source_path=$(persistent_data_category_path "$category_id")
	case "$state" in
	missing) printf 'managed link missing: %s -> %s, run: devcontainer-data repair\n' "$destination" "$source_path" ;;
	foreign) printf 'managed link points at %s, expected %s -> %s\n' "$(readlink "$destination")" "$destination" "$source_path" ;;
	unmanaged) printf 'managed link blocked by unmanaged data: %s, expected -> %s\n' "$destination" "$source_path" ;;
	esac
}

# cli_category_status <probe>: prints the identity the probe reports, "not authenticated", or "directory present" when there is no probe
cli_category_status() {
	local probe="$1" identity identity_status

	if [[ -z "$probe" ]]; then
		printf '%s\n' 'directory present'
		return 0
	fi
	identity=''
	identity_status=0
	identity=$(persistent_data_summary_identity "$probe") || identity_status=$?
	[[ "$identity_status" -eq 0 && -n "$identity" ]] || { printf '%s\n' 'not authenticated'; return 0; }
	printf 'authenticated (%s)\n' "$identity"
}

# cli_reset_category <category_id>: deletes and recreates the category directory
# Notes: the removal runs inside the parent entered with cd -P and re-checked, so a
#   parent swapped for a symlink after the realpath check is refused, not followed.
cli_reset_category() {
	local category_id="$1" fields scope relative_path root category_path root_path category_path_real
	local category_parent category_name category_parent_real category_parent_current

	fields=$(cli_category_fields "$category_id")
	IFS=$'\x1f' read -r scope relative_path _ <<<"$fields"
	root=$(persistent_data_root "$scope")
	category_path="$root/$relative_path"
	root_path=$(realpath -m "$root")
	category_path_real=$(realpath -m "$category_path")
	if [[ "$category_path_real" != "$root_path/"* ]]; then
		log_error "Persistent-data category escapes its root: $category_id"
		return 1
	fi
	if ! mountpoint -q "$root"; then
		log_error "Persistent-data category is not mounted: $category_id"
		return 1
	fi
	category_parent=$(dirname "$category_path")
	category_name=$(basename "$category_path")
	category_parent_real=$(dirname "$category_path_real")
	(
		cd -P "$category_parent" || exit 1
		category_parent_current=$(pwd -P)
		if [[ "$category_parent_current" != "$category_parent_real" ]]; then
			log_error "Persistent-data category path changed or is a symlink: $category_id"
			exit 1
		fi
		rm -rf -- "./$category_name" || exit 1
		mkdir -p -- "./$category_name"
	) || return 1
	log_success "Reset persistent-data category: $category_id"
}

# cli_reset_herdr_locked: clears the project Herdr data and restores its initial configuration
cli_reset_herdr_locked() {
	cli_reset_category herdr || return 1
	herdr_initialize_config
}

# cli_reset_herdr: resets the project Herdr configuration and reinstalls the agent integrations
# Notes: checks for Herdr before touching data or taking a lock. The integrations touch
#   shared agent config, so they run under the shared then the project lock (see
#   docs/wiki/setup/persistent-data-locks.md).
cli_reset_herdr() {
	herdr_require_command || return 1
	with_project_data_lock cli_reset_herdr_locked || return 1
	with_shared_data_lock with_project_data_lock herdr_install_integrations
}

# cli_reconcile_herdr: restores the Herdr integrations a reset of shared agent config removed
cli_reconcile_herdr() {
	herdr_apply
}

# cli_ui <operation> [arguments...]: runs the Node adapter on the terminal and stores its choice
# Returns: 2 when the Node adapter fails; an empty successful answer remains a cancellation.
# Notes: descriptor 3 carries the machine-readable answer so Inquirer's screen remains visible.
#   The adapter is only reached after the caller checks that a terminal is available.
cli_ui() {
	local operation="$1" result_file status=0 old_int old_term old_hup
	shift
	if ! command -v node >/dev/null 2>&1; then
		log_error 'node is required for interactive mode but was not found on PATH'
		return 2
	fi
	result_file=$(mktemp "${TMPDIR:-/tmp}/devcontainer-data-ui.XXXXXX") || return 2
	old_int=$(trap -p INT)
	old_term=$(trap -p TERM)
	old_hup=$(trap -p HUP)
	trap 'rm -f -- "${result_file}" || :; exit 130' INT
	trap 'rm -f -- "${result_file}" || :; exit 143' TERM
	trap 'rm -f -- "${result_file}" || :; exit 129' HUP
	if node "${DEVCONTAINER_INSTALLER_DIR}/data-ui.js" "${operation}" "$@" \
		< /dev/tty > /dev/tty 3>"${result_file}"; then
		:
	else
		status=$?
	fi
	CLI_UI_RESULT=$(<"${result_file}")
	rm -f -- "${result_file}"
	if [[ -n "${old_int}" ]]; then eval "${old_int}"; else trap - INT; fi
	if [[ -n "${old_term}" ]]; then eval "${old_term}"; else trap - TERM; fi
	if [[ -n "${old_hup}" ]]; then eval "${old_hup}"; else trap - HUP; fi
	[[ "${status}" -eq 0 ]] && return 0
	return 2
}

# cli_confirm_reset <category_id>: asks the Node adapter before a destructive reset
cli_confirm_reset() {
	local category_id="$1" reply

	if [[ ! -t 0 ]]; then
		log_error 'Reset requires an interactive confirmation or --yes'
		return 1
	fi
	cli_ui confirm-reset "${category_id}" || return $?
	reply="${CLI_UI_RESULT}"
	if [[ "${reply}" != 'yes' ]]; then
		log_error 'Reset cancelled'
		return 1
	fi
}

# ----- INTERACTIVE MENU -------------------------------------------------------

# cli_resettable_category_ids: prints the registry category ids whose resettable flag is true
cli_resettable_category_ids() {
	local category_id fields resettable
	while IFS= read -r category_id; do
		fields=$(cli_category_fields "$category_id")
		IFS=$'\x1f' read -r _ _ _ _ resettable _ <<<"$fields"
		[[ "$resettable" == 'true' ]] && printf '%s\n' "$category_id"
	done < <(inventory_ids all)
}

# cli_interactive_overview: logs the compact persistent-data snapshot shown before the menu
cli_interactive_overview() {
	local category_id fields scope relative_path label probe root status link_problem

	log_info 'Persistent data'
	log_detail 'Shared volume: devcontainer-shared-data'
	while IFS= read -r category_id; do
		fields=$(cli_category_fields "$category_id")
		IFS=$'\x1f' read -r scope relative_path label probe _ <<<"$fields"
		root=$(persistent_data_root "$scope")
		if ! mountpoint -q "$root"; then
			log_item_warning "$label · not mounted"
			continue
		fi
		if [[ ! -d "$root/$relative_path" ]]; then
			log_item_warning "$label · unavailable"
			continue
		fi
		if link_problem=$(cli_link_problem "$category_id"); then
			log_item_warning "$label · $link_problem"
			continue
		fi
		status=$(cli_category_status "$probe")
		[[ "$status" == 'directory present' ]] && status='available'
		case "$status" in
		authenticated*|available) log_item_success "$label · $status" ;;
		*) log_item_warning "$label · $status" ;;
		esac
	done < <(inventory_ids all)
}

# cli_interactive_path: asks the adapter for a category and logs its path, returning on Go back
cli_interactive_path() {
	local category_id resolved
	local -a category_ids=()
	mapfile -t category_ids < <(inventory_ids all)
	cli_ui category "${category_ids[@]}" || return $?
	category_id="${CLI_UI_RESULT}"
	[[ -n "${category_id}" ]] || return 0
	if resolved=$(cli_path "${category_id}"); then
		log_item_success "${resolved}"
	fi
}

# cli_interactive_reset: asks the adapter for a resettable category and runs the confirmed reset
# Returns: 2 for an adapter failure, 1 for an ordinary reset failure, and 0 for success or cancellation.
cli_interactive_reset() {
	local category_id
	local -a category_ids=()
	mapfile -t category_ids < <(cli_resettable_category_ids)
	if ! cli_ui category "${category_ids[@]}"; then
		return 2
	fi
	category_id="${CLI_UI_RESULT}"
	[[ -n "${category_id}" ]] || return 0
	cli_reset "${category_id}" false
}

# cli_interactive_menu: runs the adapter action menu until the user quits
cli_interactive_menu() {
	local action reset_status path_status

	while true; do
		cli_ui menu || return $?
		action="${CLI_UI_RESULT}"
		case "${action}" in
		list)
			log_blank
			cli_list
			log_blank
			;;
		status)
			log_blank
			cli_status
			log_blank
			;;
		path)
			log_blank
			if cli_interactive_path; then
				:
			else
				path_status=$?
				if [[ "${path_status}" -eq 2 ]]; then
					return 2
				fi
			fi
			log_blank
			;;
		reset)
			log_blank
			if cli_interactive_reset; then
				:
			else
				reset_status=$?
				if [[ "${reset_status}" -eq 2 ]]; then
					return 2
				fi
			fi
			log_blank
			;;
		repair)
			log_blank
			cli_repair || true
			log_blank
			;;
		quit | '') return 0 ;;
		esac
	done
}

# ----- COMMANDS ---------------------------------------------------------------

# cli_interactive: runs the terminal menu, built only from the direct commands
cli_interactive() {
	if [[ ! -t 0 ]]; then
		log_error 'Interactive mode requires a terminal'
		return 1
	fi
	cli_interactive_overview
	cli_interactive_menu
}

# cli_list: prints every declared category as id, scope and label, tab-separated
cli_list() {
	local category_id fields scope label

	while IFS= read -r category_id; do
		fields=$(cli_category_fields "$category_id")
		IFS=$'\x1f' read -r scope _ label _ <<<"$fields"
		printf '%s\t%s\t%s\n' "$category_id" "$scope" "$label"
	done < <(inventory_ids all)
}

# cli_status: prints every category's path, availability, mount and status, tab-separated
cli_status() {
	local category_id fields scope relative_path probe root category_path available mounted status link_problem

	while IFS= read -r category_id; do
		fields=$(cli_category_fields "$category_id")
		IFS=$'\x1f' read -r scope relative_path _ probe _ <<<"$fields"
		root=$(persistent_data_root "$scope")
		category_path="$root/$relative_path"
		available=false
		mounted=false
		[[ -d "$category_path" ]] && available=true
		mountpoint -q "$root" && mounted=true
		if [[ "$mounted" != true ]]; then
			status='not mounted'
		elif [[ "$available" != true ]]; then
			status='unavailable'
		elif link_problem=$(cli_link_problem "$category_id"); then
			status="$link_problem"
		else
			status=$(cli_category_status "$probe")
		fi
		printf '%s\t%s\tavailable=%s\tmounted=%s\t%s\n' "$category_id" "$category_path" "$available" "$mounted" "$status"
	done < <(inventory_ids all)
}

# cli_repair: re-creates every managed link that is not in place
# Notes: nothing else re-checks the links after setup: they are created once from
#   postCreateCommand and stay lost for the life of the container if removed. The repair
#   goes through persistent_data_link_ensure, so a path holding real data is refused
#   exactly as it is during setup.
cli_repair() {
	local category_id state destination failed=false

	while IFS= read -r category_id; do
		state=$(persistent_data_link_state "$category_id")
		[[ "$state" == 'ok' || "$state" == 'none' ]] && continue
		destination=$(persistent_data_link_path "$category_id")
		if persistent_data_link_ensure "$category_id"; then
			log_item_success "Repaired managed link: ${destination}"
		else
			failed=true
		fi
	done < <(inventory_ids all)

	[[ "$failed" == true ]] && return 1
	return 0
}

# cli_path <category_id>: prints the category's registered absolute path
cli_path() {
	persistent_data_category_path "$1"
}

# cli_reset <category_id> <assume_yes>: confirms, then resets the category under the lock its scope requires
cli_reset() {
	local category_id="$1" assume_yes="$2" fields scope resettable herdr_integration

	fields=$(cli_category_fields "$category_id") || return 1
	IFS=$'\x1f' read -r scope _ _ _ resettable herdr_integration <<<"$fields"
	if [[ "$resettable" != true ]]; then
		log_error "Persistent-data category cannot be reset: $category_id"
		return 1
	fi
	if [[ "$assume_yes" != true ]]; then
		cli_confirm_reset "$category_id" || return $?
	fi
	if [[ "$category_id" == 'herdr' ]]; then
		cli_reset_herdr || return 1
	elif [[ "$scope" == 'shared' ]]; then
		with_shared_data_lock cli_reset_category "$category_id" || return 1
	else
		with_project_data_lock cli_reset_category "$category_id" || return 1
	fi
	if [[ "$herdr_integration" == 'true' ]]; then
		cli_reconcile_herdr || return 1
	fi
}

# cli_main <subcommand> [args...]: runs one subcommand, logging the usage on a malformed call
cli_main() {
	local subcommand="${1:-}" category_id assume_yes=false

	case "$subcommand" in
	list) [[ "$#" -eq 1 ]] || { cli_usage; return 1; }; cli_list ;;
	status) [[ "$#" -eq 1 ]] || { cli_usage; return 1; }; cli_status ;;
	path) [[ "$#" -eq 2 ]] || { cli_usage; return 1; }; cli_path "$2" ;;
	repair) [[ "$#" -eq 1 ]] || { cli_usage; return 1; }; cli_repair ;;
	reset)
		[[ "$#" -eq 2 || "$#" -eq 3 ]] || { cli_usage; return 1; }
		category_id="$2"
		if [[ "$#" -eq 3 ]]; then
			[[ "$3" == '--yes' ]] || { cli_usage; return 1; }
			assume_yes=true
		fi
		cli_reset "$category_id" "$assume_yes"
		;;
	interactive) [[ "$#" -eq 1 ]] || { cli_usage; return 1; }; cli_interactive ;;
	*) cli_usage; return 1 ;;
	esac
}

cli_main "$@"
