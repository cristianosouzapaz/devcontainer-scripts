#!/bin/bash
set -euo pipefail

# Direct CLI for persistent-data categories.

# ----- SHARED UTILITIES LOADING -----------------------------------------------

# why: readlink -f, so a symlink on PATH still finds the script tree
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
BOOTSTRAP_LIB_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/../setup/lib" && pwd)"
source "$BOOTSTRAP_LIB_DIR/loader.sh"

# ----- INTERNAL HELPERS -------------------------------------------------------

# cli_usage: logs the supported command syntax
cli_usage() {
	log_info 'Usage: devcontainer-data {list|status [--json]|path <id>|repair|reset <id> [--yes]|update herdr [--replace [--yes]]|interactive}'
}

# cli_category_fields <category_id>: prints scope, relative path, label, identity, resettable and Herdr integration, joined by unit separators with empty fields kept
cli_category_fields() {
	inventory_fields all "$1" scope relativePath label identity resettable herdrIntegration
}

# cli_link_problem_message <category_id> <state>: prints the managed-link diagnostic for a non-healthy state
cli_link_problem_message() {
	local category_id="$1" state="$2" destination source_path

	destination=$(persistent_data_link_path "$category_id")
	source_path=$(persistent_data_category_path "$category_id")
	case "$state" in
	missing) printf 'managed link missing: %s -> %s, run: devcontainer-data repair\n' "$destination" "$source_path" ;;
	foreign) printf 'managed link points at %s, expected %s -> %s\n' "$(readlink "$destination")" "$destination" "$source_path" ;;
	unmanaged) printf 'managed link blocked by unmanaged data: %s, expected -> %s\n' "$destination" "$source_path" ;;
	*) return 1 ;;
	esac
}

# cli_link_problem <category_id>: prints what is wrong with the category's managed link, naming the path and its expected target
# Returns: 1 when the link is in place or the category has no managed link.
# Notes: callers check a broken link before authentication so its repair action is not mistaken for a login action.
cli_link_problem() {
	local category_id="$1" state

	state=$(persistent_data_link_state "$category_id")
	[[ "$state" == 'ok' || "$state" == 'none' ]] && return 1
	cli_link_problem_message "$category_id" "$state"
}

# cli_category_status <probe>: prints the identity the probe reports, "not authenticated", or "directory present" when there is no probe
cli_category_status() {
	local probe="$1" identity identity_status

	if [[ -z "$probe" ]]; then
		printf '%s\n' 'directory present'
		return 0
	fi
	identity=''
	identity_status=0
	identity=$(persistent_data_summary_identity "$probe") || identity_status=$?
	[[ "$identity_status" -eq 0 && -n "$identity" ]] || { printf '%s\n' 'not authenticated'; return 0; }
	printf 'authenticated (%s)\n' "$identity"
}

# cli_reset_category <category_id>: deletes and recreates the category directory
# Notes: the removal runs inside the parent entered with cd -P and re-checked, so a
#   parent swapped for a symlink after the realpath check is refused, not followed.
cli_reset_category() {
	local category_id="$1" fields scope relative_path root category_path root_path category_path_real
	local category_parent category_name category_parent_real category_parent_current

	fields=$(cli_category_fields "$category_id")
	IFS=$'\x1f' read -r scope relative_path _ <<<"$fields"
	root=$(persistent_data_root "$scope")
	category_path="$root/$relative_path"
	root_path=$(realpath -m "$root")
	category_path_real=$(realpath -m "$category_path")
	if [[ "$category_path_real" != "$root_path/"* ]]; then
		log_error "Persistent-data category escapes its root: $category_id"
		return 1
	fi
	if ! mountpoint -q "$root"; then
		log_error "Persistent-data category is not mounted: $category_id"
		return 1
	fi
	category_parent=$(dirname "$category_path")
	category_name=$(basename "$category_path")
	category_parent_real=$(dirname "$category_path_real")
	(
		cd -P "$category_parent" || exit 1
		category_parent_current=$(pwd -P)
		if [[ "$category_parent_current" != "$category_parent_real" ]]; then
			log_error "Persistent-data category path changed or is a symlink: $category_id"
			exit 1
		fi
		rm -rf -- "./$category_name" || exit 1
		mkdir -p -- "./$category_name"
	) || return 1
	log_success "Reset persistent-data category: $category_id"
}

# cli_reset_herdr_locked: clears the project Herdr data and restores its initial configuration
cli_reset_herdr_locked() {
	local metadata
	cli_validate_herdr_paths || return 1
	metadata=$(herdr_metadata_path) || return 1
	cli_reset_category herdr || return 1
	rm -rf -- "$metadata" || return 1
	herdr_initialize_config
}

# cli_reset_herdr: resets the project Herdr configuration and reinstalls the agent integrations
# Notes: checks for Herdr before touching data or taking a lock. The integrations touch
#   shared agent config, so they run under the shared then the project lock (see
#   docs/wiki/setup/persistent-data-locks.md).
cli_reset_herdr() {
	herdr_require_command || return 1
	with_project_data_lock cli_reset_herdr_locked || return 1
	with_shared_data_lock with_project_data_lock herdr_install_integrations
}

# cli_reconcile_herdr: restores the Herdr integrations a reset of shared agent config removed
cli_reconcile_herdr() {
	herdr_apply
}

# cli_ui <operation> [arguments...]: runs the Node adapter on the terminal and stores its choice
# Returns: 2 when the Node adapter fails; an empty successful answer remains a cancellation.
# Notes: descriptor 3 carries the machine-readable answer so Inquirer's screen remains visible.
#   The adapter is only reached after the caller checks that a terminal is available.
cli_ui() {
	local operation="$1" result_file status=0 old_int old_term old_hup
	shift
	if ! command -v node >/dev/null 2>&1; then
		log_error 'node is required for interactive mode but was not found on PATH'
		return 2
	fi
	result_file=$(mktemp "${TMPDIR:-/tmp}/devcontainer-data-ui.XXXXXX") || return 2
	old_int=$(trap -p INT)
	old_term=$(trap -p TERM)
	old_hup=$(trap -p HUP)
	trap 'rm -f -- "${result_file}" || :; exit 130' INT
	trap 'rm -f -- "${result_file}" || :; exit 143' TERM
	trap 'rm -f -- "${result_file}" || :; exit 129' HUP
	if node "${DEVCONTAINER_INSTALLER_DIR}/data-ui.js" "${operation}" "$@" \
		< /dev/tty > /dev/tty 3>"${result_file}"; then
		:
	else
		status=$?
	fi
	CLI_UI_RESULT=$(<"${result_file}")
	rm -f -- "${result_file}"
	if [[ -n "${old_int}" ]]; then eval "${old_int}"; else trap - INT; fi
	if [[ -n "${old_term}" ]]; then eval "${old_term}"; else trap - TERM; fi
	if [[ -n "${old_hup}" ]]; then eval "${old_hup}"; else trap - HUP; fi
	[[ "${status}" -eq 0 ]] && return 0
	return 2
}

# cli_confirm_reset <category_id>: asks the Node adapter before a destructive reset
cli_confirm_reset() {
	local category_id="$1" reply

	if [[ ! -t 0 ]]; then
		log_error 'Reset requires an interactive confirmation or --yes'
		return 1
	fi
	cli_ui confirm-reset "${category_id}" || return $?
	reply="${CLI_UI_RESULT}"
	if [[ "${reply}" != 'yes' ]]; then
		log_error 'Reset cancelled'
		return 1
	fi
}

# ----- INTERACTIVE MENU -------------------------------------------------------

# cli_resettable_category_ids: prints the registry category ids whose resettable flag is true
cli_resettable_category_ids() {
	local category_id fields resettable
	while IFS= read -r category_id; do
		fields=$(cli_category_fields "$category_id")
		IFS=$'\x1f' read -r _ _ _ _ resettable _ <<<"$fields"
		[[ "$resettable" == 'true' ]] && printf '%s\n' "$category_id"
	done < <(inventory_ids all)
}

# cli_interactive_overview: logs the compact persistent-data snapshot shown before the menu
cli_interactive_overview() {
	local category_id fields scope relative_path label probe root status link_problem

	log_info 'Persistent data'
	log_detail 'Shared volume: devcontainer-shared-data'
	while IFS= read -r category_id; do
		fields=$(cli_category_fields "$category_id")
		IFS=$'\x1f' read -r scope relative_path label probe _ <<<"$fields"
		root=$(persistent_data_root "$scope")
		if ! mountpoint -q "$root"; then
			log_item_warning "$label · not mounted"
			continue
		fi
		if [[ ! -d "$root/$relative_path" ]]; then
			log_item_warning "$label · unavailable"
			continue
		fi
		if link_problem=$(cli_link_problem "$category_id"); then
			log_item_warning "$label · $link_problem"
			continue
		fi
		status=$(cli_category_status "$probe")
		[[ "$status" == 'directory present' ]] && status='available'
		case "$status" in
		authenticated*|available) log_item_success "$label · $status" ;;
		*) log_item_warning "$label · $status" ;;
		esac
	done < <(inventory_ids all)
}

# cli_interactive_path: asks the adapter for a category and logs its path, returning on Go back
cli_interactive_path() {
	local category_id resolved
	local -a category_ids=()
	mapfile -t category_ids < <(inventory_ids all)
	cli_ui category "${category_ids[@]}" || return $?
	category_id="${CLI_UI_RESULT}"
	[[ -n "${category_id}" ]] || return 0
	if resolved=$(cli_path "${category_id}"); then
		log_item_success "${resolved}"
	fi
}

# cli_interactive_reset: asks the adapter for a resettable category and runs the confirmed reset
# Returns: 2 for an adapter failure, 1 for an ordinary reset failure, and 0 for success or cancellation.
cli_interactive_reset() {
	local category_id
	local -a category_ids=()
	mapfile -t category_ids < <(cli_resettable_category_ids)
	if ! cli_ui category "${category_ids[@]}"; then
		return 2
	fi
	category_id="${CLI_UI_RESULT}"
	[[ -n "${category_id}" ]] || return 0
	cli_reset "${category_id}" false
}

# cli_interactive_menu: runs the adapter action menu until the user quits
cli_interactive_menu() {
	local action reset_status path_status update_status

	while true; do
		log_blank
		cli_ui menu || return $?
		action="${CLI_UI_RESULT}"
		case "${action}" in
		list)
			cli_list
			;;
		status)
			cli_status
			;;
		path)
			if cli_interactive_path; then
				:
			else
				path_status=$?
				if [[ "${path_status}" -eq 2 ]]; then
					return 2
				fi
			fi
			;;
		reset)
			if cli_interactive_reset; then
				:
			else
				reset_status=$?
				if [[ "${reset_status}" -eq 2 ]]; then
					return 2
				fi
			fi
			;;
		repair)
			cli_repair || true
			;;
		update)
			if cli_update herdr false false; then
				:
			else
				update_status=$?
				[[ "$update_status" -eq 2 ]] && return 2
			fi
			;;
		quit | '') return 0 ;;
		esac
	done
}

# ----- COMMANDS ---------------------------------------------------------------

# cli_interactive: runs the terminal menu, built only from the direct commands
cli_interactive() {
	if [[ ! -t 0 ]]; then
		log_error 'Interactive mode requires a terminal'
		return 1
	fi
	cli_interactive_overview
	cli_interactive_menu
}

# cli_list: prints every declared category as id, scope and label, tab-separated
cli_list() {
	local category_id fields scope label

	while IFS= read -r category_id; do
		fields=$(cli_category_fields "$category_id")
		IFS=$'\x1f' read -r scope _ label _ <<<"$fields"
		printf '%s\t%s\t%s\n' "$category_id" "$scope" "$label"
	done < <(inventory_ids all)
}

# cli_status_rows: prints the category status records used by both status renderers, unit-separated
cli_status_rows() {
	local category_id fields scope relative_path label probe login_hint root category_path available mounted
	local link health detail action_label action_command

	while IFS= read -r category_id; do
		fields=$(inventory_fields all "$category_id" scope relativePath label identity loginHint)
		IFS=$'\x1f' read -r scope relative_path label probe login_hint <<<"$fields"
		root=$(persistent_data_root "$scope")
		category_path="$root/$relative_path"
		available=false
		mounted=false
		link=''
		health='ok'
		detail=''
		action_label=''
		action_command=''
		[[ -d "$category_path" ]] && available=true
		mountpoint -q "$root" && mounted=true
		if [[ "$mounted" != true ]]; then
			health='error'
			detail='not mounted'
			action_label="Mount ${scope} root"
		elif [[ "$available" != true ]]; then
			health='error'
			detail='unavailable'
			action_label='Restore category directory'
		else
			link=$(persistent_data_link_state "$category_id")
			case "$link" in
			ok | none)
				detail=$(cli_category_status "$probe")
				if [[ "$detail" == 'directory present' ]]; then
					detail='available'
				elif [[ "$detail" != authenticated* ]]; then
					health='warning'
					action_label='Log in'
					action_command="$login_hint"
				fi
				;;
			missing)
				health='error'
				detail=$(cli_link_problem_message "$category_id" "$link")
				action_label='Repair managed link'
				action_command='devcontainer-data repair'
				;;
			foreign | unmanaged)
				health='error'
				detail=$(cli_link_problem_message "$category_id" "$link")
				action_label='Managed link requires manual repair'
				;;
			esac
		fi
		printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
			"$category_id" "$label" "$scope" "$relative_path" "$category_path" "$mounted" "$available" \
			"$link" "$health" "$detail" "$action_label" "$action_command"
	done < <(inventory_ids all)
}

# cli_status_symbol <health> <color_enabled>: prints the status symbol, optionally colored for a human report
cli_status_symbol() {
	local health="$1" color_enabled="$2" symbol color=''

	case "$health" in
	ok) symbol='✓'; color='\033[0;32m' ;;
	warning) symbol='!'; color='\033[0;33m' ;;
	error) symbol='✗'; color='\033[0;31m' ;;
	esac
	if [[ "$color_enabled" == true ]]; then
		printf '%b%s\033[0m' "$color" "$symbol"
	else
		printf '%s' "$symbol"
	fi
}

# cli_status_table <rows>: prints a human-readable report from unit-separated category status records
cli_status_table() {
	local rows="$1" shared_root project_root category_id label scope relative_path category_path mounted available
	local link health detail action_label action_command action i color_enabled=false
	local status_width=6 item_width=4 scope_width=5 path_width=4 health_width=6 action_width=6
	local -a labels=() scopes=() relative_paths=() healths=() details=() actions=()

	shared_root=$(persistent_data_root shared)
	project_root=$(persistent_data_root project)
	[[ -t 1 && ! -v NO_COLOR ]] && color_enabled=true
	while IFS=$'\x1f' read -r category_id label scope relative_path category_path mounted available link health detail action_label action_command; do
		[[ -n "$category_id" ]] || continue
		action="$action_label"
		[[ -n "$action_command" ]] && action+=" : $action_command"
		labels+=("$label")
		scopes+=("$scope")
		relative_paths+=("$relative_path")
		healths+=("$health")
		details+=("$detail")
		actions+=("$action")
		((${#label} > item_width)) && item_width=${#label}
		((${#scope} > scope_width)) && scope_width=${#scope}
		((${#relative_path} > path_width)) && path_width=${#relative_path}
		((${#detail} > health_width)) && health_width=${#detail}
		((${#action} > action_width)) && action_width=${#action}
	done <<<"$rows"

	printf 'Shared mount root: %s\nProject mount root: %s\n\n' "$shared_root" "$project_root"
	printf '%-*s  %-*s  %-*s  %-*s  %-*s  %s\n' \
		"$status_width" 'STATUS' "$item_width" 'ITEM' "$scope_width" 'SCOPE' "$path_width" 'PATH' "$health_width" 'HEALTH' 'ACTION'
	for i in "${!labels[@]}"; do
		printf '%s%*s  %-*s  %-*s  %-*s  %-*s  %s\n' \
			"$(cli_status_symbol "${healths[$i]}" "$color_enabled")" "$((status_width - 1))" '' "$item_width" "${labels[$i]}" \
			"$scope_width" "${scopes[$i]}" "$path_width" "${relative_paths[$i]}" \
			"$health_width" "${details[$i]}" "${actions[$i]}"
	done
}

# cli_status_json <rows>: prints one JSON status report without terminal formatting
cli_status_json() {
	local rows="$1" category_id label scope relative_path category_path mounted available link health detail
	local action_label action_command action category_json categories='' overall='ok' first=true

	while IFS=$'\x1f' read -r category_id label scope relative_path category_path mounted available link health detail action_label action_command; do
		[[ -n "$category_id" ]] || continue
		if [[ "$health" == 'error' ]]; then
			overall='error'
		elif [[ "$health" == 'warning' && "$overall" == 'ok' ]]; then
			overall='warning'
		fi
		if [[ -n "$action_label" ]]; then
			action="{\"label\":$(json_quote "$action_label"),\"command\":"
			if [[ -n "$action_command" ]]; then
				action+="$(json_quote "$action_command")"
			else
				action+='null'
			fi
			action+='}'
		else
			action='null'
		fi
		if [[ -n "$link" ]]; then
			link=$(json_quote "$link")
		else
			link='null'
		fi
		category_json="{\"id\":$(json_quote "$category_id"),\"scope\":$(json_quote "$scope"),\"path\":$(json_quote "$category_path"),\"mounted\":$mounted,\"available\":$available,\"link\":$link,\"health\":$(json_quote "$health"),\"action\":$action}"
		if [[ "$first" == true ]]; then
			first=false
		else
			categories+=','
		fi
		categories+="$category_json"
	done <<<"$rows"
	printf '{"version":1,"overall":%s,"categories":[%s]}\n' "$(json_quote "$overall")" "$categories"
}

# cli_status [table|json]: collects status once and renders it for people or automation
cli_status() {
	local format="${1:-table}" rows

	rows=$(cli_status_rows)
	case "$format" in
	table) cli_status_table "$rows" ;;
	json) cli_status_json "$rows" ;;
	esac
}

# cli_repair: re-creates every managed link that is not in place
# Notes: nothing else re-checks the links after setup: they are created once from
#   postCreateCommand and stay lost for the life of the container if removed. The repair
#   goes through persistent_data_link_ensure, so a path holding real data is refused
#   exactly as it is during setup.
cli_repair() {
	local category_id state destination failed=false

	while IFS= read -r category_id; do
		state=$(persistent_data_link_state "$category_id")
		[[ "$state" == 'ok' || "$state" == 'none' ]] && continue
		destination=$(persistent_data_link_path "$category_id")
		if persistent_data_link_ensure "$category_id"; then
			log_item_success "Repaired managed link: ${destination}"
		else
			failed=true
		fi
	done < <(inventory_ids all)

	[[ "$failed" == true ]] && return 1
	return 0
}

# cli_path <category_id>: prints the category's registered absolute path
cli_path() {
	persistent_data_category_path "$1"
}

# cli_reset <category_id> <assume_yes>: confirms, then resets the category under the lock its scope requires
cli_reset() {
	local category_id="$1" assume_yes="$2" fields scope resettable herdr_integration

	fields=$(cli_category_fields "$category_id") || return 1
	IFS=$'\x1f' read -r scope _ _ _ resettable herdr_integration <<<"$fields"
	if [[ "$resettable" != true ]]; then
		log_error "Persistent-data category cannot be reset: $category_id"
		return 1
	fi
	if [[ "$assume_yes" != true ]]; then
		cli_confirm_reset "$category_id" || return $?
	fi
	if [[ "$category_id" == 'herdr' ]]; then
		cli_reset_herdr || return 1
	elif [[ "$scope" == 'shared' ]]; then
		with_shared_data_lock cli_reset_category "$category_id" || return 1
	else
		with_project_data_lock cli_reset_category "$category_id" || return 1
	fi
	if [[ "$herdr_integration" == 'true' ]]; then
		cli_reconcile_herdr || return 1
	fi
}

# cli_validate_herdr_paths: refuses writes outside the mounted project and redirected metadata
cli_validate_herdr_paths() {
	local root config_path root_real
	root=$(persistent_data_root project) || return 1
	if ! mountpoint -q "$root"; then
		log_error 'Persistent-data category is not mounted: herdr'
		return 1
	fi
	root_real=$(realpath -m "$root") || return 1
	config_path=$(herdr_config_path) || return 1
	if [[ "$(realpath -m "$config_path")" != "$root_real/"* ]]; then
		log_error 'Herdr configuration escapes its project path'
		return 1
	fi
	herdr_validate_metadata_path
}

# cli_update_herdr_locked <replace> <assume_yes>: updates only persistent config, never scripts or packages
cli_update_herdr_locked() {
	local replace="$1" assume_yes="$2" config_path template metadata managed_hash='' current_hash backup timestamp

	cli_validate_herdr_paths || return 1
	config_path=$(herdr_config_path) || return 1
	template=$(herdr_template_path) || return 1
	metadata=$(herdr_metadata_path) || return 1
	if [[ "$replace" == true && "$assume_yes" != true ]]; then
		if [[ ! -t 0 ]]; then
			log_error 'Replacement requires an interactive confirmation or --replace --yes'
			return 1
		fi
		cli_ui confirm-replace || return $?
		if [[ "$CLI_UI_RESULT" != yes ]]; then
			log_error 'Update cancelled'
			return 1
		fi
	fi
	if [[ ! -e "$config_path" && ! -L "$config_path" ]]; then
		herdr_initialize_config
		return $?
	fi
	if [[ ! -f "$config_path" ]]; then
		log_error "Not a regular Herdr configuration: $config_path"
		return 1
	fi
	if [[ -f "$metadata/config-template.sha256" ]]; then
		managed_hash=$(<"$metadata/config-template.sha256")
	fi
	current_hash=$(sha256sum < "$config_path") || return 1
	current_hash="${current_hash%% *}"
	if [[ "$replace" != true && "$managed_hash" =~ ^[a-f0-9]{64}$ && "$current_hash" == "$managed_hash" ]]; then
		if cmp -s "$config_path" "$template"; then
			log_success 'Herdr configuration is already current'
			return 0
		fi
		replace=true
	elif [[ "$replace" != true && ! "$managed_hash" =~ ^[a-f0-9]{64}$ && -t 0 ]]; then
		cli_ui first-update || return $?
		case "$CLI_UI_RESULT" in
		replace) replace=true ;;
		keep) ;;
		*) log_error 'Update cancelled'; return 1 ;;
		esac
	fi
	if [[ "$replace" != true ]]; then
		# why: A pre-existing candidate may contain user edits or alias the preserved config via symlink.
		if [[ -e "$config_path.new" || -L "$config_path.new" ]]; then
			log_error "Refusing to overwrite an existing Herdr candidate: $config_path.new"
			return 1
		fi
		atomic_write "$config_path.new" cat "$template" || return 1
		log_warning "Preserved Herdr configuration; review $config_path.new or use update herdr --replace"
		return 0
	fi
	# why: Nanoseconds prevent serialized same-second updates from reusing a backup path.
	timestamp=$(date -u +%Y%m%dT%H%M%S.%NZ) || return 1
	backup="$config_path.bak.$timestamp"
	[[ ! -e "$backup" && ! -L "$backup" ]] || { log_error "Backup already exists: $backup"; return 1; }
	(umask 077; atomic_write "$backup" cat "$config_path") || return 1
	herdr_write_managed_config "$config_path" "$template" || return 1
	log_success "Updated Herdr configuration; backup: $backup"
}

# cli_update <category_id> <replace> <assume_yes>: serializes config decisions with setup and reset
cli_update() {
	if [[ "$1" != herdr ]]; then
		log_error "Persistent-data category cannot be updated: $1"
		return 1
	fi
	# why: Validate before locking because acquiring the lock creates the root and lock file.
	cli_validate_herdr_paths || return 1
	with_project_data_lock cli_update_herdr_locked "$2" "$3"
}

# cli_main <subcommand> [args...]: runs one subcommand, logging the usage on a malformed call
cli_main() {
	local subcommand="${1:-}" category_id assume_yes=false replace=false flag

	case "$subcommand" in
	list) [[ "$#" -eq 1 ]] || { cli_usage; return 1; }; cli_list ;;
	status)
		[[ "$#" -eq 1 || ( "$#" -eq 2 && "$2" == '--json' ) ]] || { cli_usage; return 1; }
		if [[ "${2:-}" == '--json' ]]; then
			cli_status json
		else
			cli_status
		fi
		;;
	path) [[ "$#" -eq 2 ]] || { cli_usage; return 1; }; cli_path "$2" ;;
	repair) [[ "$#" -eq 1 ]] || { cli_usage; return 1; }; cli_repair ;;
	reset)
		[[ "$#" -eq 2 || "$#" -eq 3 ]] || { cli_usage; return 1; }
		category_id="$2"
		if [[ "$#" -eq 3 ]]; then
			[[ "$3" == '--yes' ]] || { cli_usage; return 1; }
			assume_yes=true
		fi
		cli_reset "$category_id" "$assume_yes"
		;;
	update)
		[[ "$#" -ge 2 && "$#" -le 4 ]] || { cli_usage; return 1; }
		category_id="$2"
		shift 2
		for flag in "$@"; do
			case "$flag" in
			--replace) [[ "$replace" == false ]] || { cli_usage; return 1; }; replace=true ;;
			--yes) [[ "$assume_yes" == false ]] || { cli_usage; return 1; }; assume_yes=true ;;
			*) cli_usage; return 1 ;;
			esac
		done
		[[ "$assume_yes" == false || "$replace" == true ]] || { cli_usage; return 1; }
		cli_update "$category_id" "$replace" "$assume_yes"
		;;
	interactive) [[ "$#" -eq 1 ]] || { cli_usage; return 1; }; cli_interactive ;;
	*) cli_usage; return 1 ;;
	esac
}

cli_main "$@"
