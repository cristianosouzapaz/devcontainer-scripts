#!/bin/bash
set -euo pipefail

# Stable BROWSER and GH_BROWSER target for long-lived terminal sessions: opens the URLs through a
# live editor connection resolved at every call (see setup/lib/editor.sh). DEVCONTAINER_EDITOR
# picks the editor; exit codes follow xdg-open: 1 without a URL, 3 when no live editor is found, 4
# when it rejects the call.

# ----- SHARED UTILITIES LOADING -----------------------------------------------

# why: readlink -f, so a symlink on PATH still finds the script tree
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
BOOTSTRAP_LIB_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/../setup/lib" && pwd)"
source "$BOOTSTRAP_LIB_DIR/loader.sh"

# ----- FUNCTIONS --------------------------------------------------------------

# main <url...>: opens the URLs on the host through the editor's open-URL argument
main() {
	local status=0
	if [[ $# -eq 0 ]]; then
		log_error "Usage: devcontainer-browser <url>"
		exit 1
	fi
	editor_run '' openUrlArgument "$@" || status=$?
	if [[ $status -ne 0 ]]; then
		log_error "Open it by hand: $*"
		exit "$status"
	fi
}

main "$@"
